# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# GPS Routing & ETA Engine (OSRM)
# Public free server (default for development/testing):
VITE_OSRM_URL=https://router.project-osrm.org
# Metro Manila traffic compensation factor (default: 1.3 = +30% travel time)
VITE_TRAFFIC_FACTOR=1.3

# Teleconsultation TURN relay (local development only)
# Production credentials are minted per call by the `ice-servers` Edge Function, whose
# secrets live in `supabase secrets set` — never here. Anything in a VITE_ variable is
# readable in the shipped JS bundle, so a static TURN login placed here can be abused by
# anyone who opens DevTools. Only set these to test a relay without deploying the function.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

